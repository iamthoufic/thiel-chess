# dependencies and environments
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Chess.com game data: the compressed dataset (.gz) is committed. The uncompressed
# raw PGN (~115 MB) is over GitHub's file limit and is rebuilt by `npm run data:fetch`.
data/raw/*.pgn
data/**/*.tmp*

# training outputs (large; the exported model ships in web/model/)
training/cache/
training/checkpoints/
training/*.log

# build output: the single-file offline page (~90 MB), rebuilt with `npm run web:single`
web/dist/

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.vercel
